# Every request under /api goes to index.php; source, migrations and scripts are never served directly.
Options -Indexes
RewriteEngine On
RewriteBase /api/
RewriteRule ^index\.php$ - [L]
RewriteRule ^ index.php [L,QSA]

<FilesMatch "\.(sql|md|example|json)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set Cache-Control "no-store"
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
