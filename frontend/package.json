{
  "name": "byhnex-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "typecheck": "vue-tsc --build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:visual": "playwright test",
    "test:visual:record": "playwright test --project=record"
  },
  "dependencies": {
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tsconfig/node22": "22.0.6",
    "@types/node": "26.6.4",
    "@types/pngjs": "6.0.5",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "jiti": "2.7.0",
    "jsdom": "30.1.2",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  }
}
